# Learning records and backups: never publish personal learning data.
data/
backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.backup
*.bak

# Secrets and local configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
